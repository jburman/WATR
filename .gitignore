## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Visual Studio 2019 cache/options directory
.idea/

# Visual Studio Code
.vscode/

# Runsettings
*.runsettings

# Visual Studio 2017+ performance/diagnostic files
*.diagsession

# DotnetCore
*.project.json
*.classpath
*.stylecop
*.json

# Visual Studio for Mac
*.pidb
*.resources
*.svntoy

# NetCore
*.project.lock.json

# C#
*.cs.meta

# AOT
*.il
*.map

# Azure
csx/
*.build.csdef

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# Note: Comment the next line if you want to checkin your web deploy settings,
# but database connection strings (with potential passwords) will be unencrypted
*.pubxml
*.publishproj

# Microsoft Azure Web App
App_Data/
jobs/

# Windows Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Cloud Service
*.csx/
*.dxceditor
*.log

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx

# Visual Studio cache files
# files ending in .cache can be safely ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Including strong name files can present a security risk
# (if you want to include them, comment out the following line)
*.snk

# NuGet
*.nupkg
# The packages folder can generally be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/repositories.config
# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

# Microsoft Office tooling
*.vo

# SpecFlow for Visual Studio
*.tech.events

# Krypton Toolkit
*.kx

# Benchmarking
BenchmarkDotNet.Artifacts/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield
*.ism

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a .NET coding add-in
.JustCode

# TeamCity is a build add-in
_TeamCity*

# DotCover is a Code Coverage Tool
*.dotCover

# AxoCover is a Code Coverage Tool
.axoCover/*
!.axoCover/settings.json

# Coverlet is a code coverage tool
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio code coverage
*.coverage
*.coveragexml

# NUnit
*.VisualState.xml
TestResult.xml
NResult.xml

# Must have for NCrunch
*.ncrunch.project
*.ncrunch.solution

# NSIS
*.isl

# Global
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Python
*.pyc

# Rider
.idea
*.sln.iml

# Microsoft.Extensions.SecretManager
.microsoft.usersecrets

# User secrets
secrets.json

# Tye
.tye/

# Other
bin/
obj/
