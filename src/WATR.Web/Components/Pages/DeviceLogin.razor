@page "/device"
@using WATR.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject DeviceCodeService DeviceCodeService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <RadzenCard class="rz-shadow-10">
                <RadzenText TextStyle="TextStyle.H4" class="rz-mb-4 text-center">Authorize Device 📟</RadzenText>
                
                <div class="rz-p-4">
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4 text-center">
                        Please enter the device code displayed in your terminal to authorize the CLI.
                    </RadzenText>
                    
                    <RadzenFormField Text="Device Code" class="w-100 rz-mb-4">
                        <RadzenTextBox @bind-Value="code" class="w-100 text-center" Style="font-size: 2rem; letter-spacing: 0.5rem;" 
                                       Placeholder="XXXX-XXXX" @onkeyup="@HandleKeyUp" />
                    </RadzenFormField>
                    
                    <RadzenButton Text="Authorize" Click="@OnAuthorize" class="w-100" Busy="@isBusy" />
                </div>
            </RadzenCard>
        </div>
    </div>
</div>

@code {
    private string code = "";
    private bool isBusy = false;

    async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnAuthorize();
        }
    }

    async Task OnAuthorize()
    {
        if (string.IsNullOrWhiteSpace(code)) return;

        // Normalize code: remove dashes and trim
        var normalizedCode = code.Replace("-", "").Trim();
        
        // If it's 8 digits, ensure it has the dash for the backend check if stored with dash
        // Backend stores with dash? Let's check DeviceCodeService.
        // Assuming backend stores AS GENERATED.
        // CLI generates: $"{num.Substring(0, 4)}-{num.Substring(4, 4)}" -> 1234-5678
        // So backend expects DASH.
        
        if (normalizedCode.Length == 8)
        {
            normalizedCode = normalizedCode.Insert(4, "-");
        }

        isBusy = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            
            if (userIdClaim == null)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "User not found in session");
                return;
            }

            var userId = Guid.Parse(userIdClaim.Value);
            
            var success = await DeviceCodeService.ApproveAsync(normalizedCode, userId);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Device authorized!");
                code = "";
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Invalid or expired code");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
