@page "/"
@using WATR.Web.Services
@using WATR.Web.Components.Dialogs
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@attribute [Authorize]
@inject TaskService TaskService
@inject ProjectContextService ProjectContext
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject ProtectedLocalStorage LocalStorage
@implements IAsyncDisposable

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Tasks</RadzenText>
        <RadzenButton Icon="add" Text="New Task" Click="@OnNewTask" Disabled="@(ProjectContext.SelectedProject == null)" />
    </RadzenStack>

    @if (ProjectContext.SelectedProject == null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info">Please select a project to view tasks.</RadzenAlert>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="rz-mb-4">
            <RadzenLabel Text="Status:" Style="margin-right: 0.5rem;" />
            <RadzenDropDown TValue="IEnumerable<TaskItemStatus>" @bind-Value="selectedStatuses" Data="@allStatuses" 
                            Multiple="true" Chips="true" AllowClear="true" Placeholder="Select statuses..."
                            Change="@OnStatusFilterChanged" Style="width: 500px;" PopupStyle="height: 260px;" MaxHeight="400px" />
        </RadzenStack>

        <RadzenDataGrid @ref="grid" Data="@tasks" TItem="TaskItemSummaryDto" KeyProperty="Id"
                        RowExpand="@OnRowExpand" RowCollapse="@OnRowCollapse"
                        AllowPaging="true" PageSize="20" AllowSorting="true"
                        RowSelect="@OnRowSelect" class="rz-shadow-2">
            <Template Context="t">
                <TaskPreview TaskId="@t.Id" />
            </Template>
            <Columns>
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="Id" Title="ID" Width="100px">
                    <Template Context="t">
                        @t.Id.ToString()[..8]
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="TaskHandle" Title="Handle" Width="120px" />
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="Title" Title="Title" />
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="Status" Title="Status" Width="150px">
                    <Template Context="t">
                        @if (editingStatusId == t.Id)
                        {
                            <div @onclick:stopPropagation="true">
                                <RadzenDropDown TValue="TaskItemStatus" Value="@t.Status" Data="@(Enum.GetValues<TaskItemStatus>())"
                                                Change="@(args => OnStatusChange(t, (TaskItemStatus)args))"
                                                Style="width: 100%; height: 30px; font-size: 0.875rem; padding: 0;" PopupStyle="height: 260px;" />
                            </div>
                        }
                        else
                        {
                            <div @onclick="@(() => editingStatusId = t.Id)" @onclick:stopPropagation="true" style="cursor: pointer; width: 100%; height: 100%; display: flex; align-items: center;">
                                <RadzenBadge BadgeStyle="@GetStatusStyle(t.Status)" Text="@t.Status.ToString()" />
                            </div>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="Priority" Title="Priority" Width="120px">
                    <Template Context="t">
                        <RadzenBadge BadgeStyle="@GetPriorityStyle(t.Priority)" Text="@t.Priority.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="AssignedToDisplayName" Title="Assigned To" Width="150px">
                    <Template Context="t">
                        @(t.AssignedToDisplayName ?? "Unassigned")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaskItemSummaryDto" Property="UpdatedAt" Title="Updated" Width="180px">
                    <Template Context="t">
                        @t.UpdatedAt.ToLocalTime().ToString("g")
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    private RadzenDataGrid<TaskItemSummaryDto>? grid;
    private List<TaskItemSummaryDto> tasks = new();
    private HubConnection? hubConnection;
    private Guid currentUserId;
    private Guid? editingStatusId;
    private readonly HashSet<Guid> expandedTaskIds = new();
    private IEnumerable<TaskItemStatus> allStatuses = Enum.GetValues<TaskItemStatus>();
    private IEnumerable<TaskItemStatus> selectedStatuses = new List<TaskItemStatus> { TaskItemStatus.Open, TaskItemStatus.InProgress };

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateTask;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUserId = Guid.Parse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
        }

        try
        {
            var result = await LocalStorage.GetAsync<IEnumerable<TaskItemStatus>>("dashboardStatusFilter");
            if (result.Success && result.Value != null)
            {
                selectedStatuses = result.Value;
            }
        }
        catch { /* Ignore storage errors */ }

        ProjectContext.OnProjectChanged += RefreshData;
        await LoadTasks();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/tasks"))
            .Build();

        hubConnection.On<Guid>("TaskCreated", _ => OnTaskEventReceivedAsync());
        hubConnection.On<Guid>("TaskUpdated", _ => OnTaskEventReceivedAsync());
        hubConnection.On<Guid, Guid>("TaskClaimed", (_, _) => OnTaskEventReceivedAsync());
        hubConnection.On<Guid>("TaskReleased", _ => OnTaskEventReceivedAsync());
        hubConnection.On<Guid>("NoteAdded", _ => OnTaskEventReceivedAsync());

        await hubConnection.StartAsync();
        if (ProjectContext.SelectedProject != null)
        {
            await hubConnection.InvokeAsync("JoinProject", ProjectContext.SelectedProject.Id.ToString());
        }
    }

    private async Task OnStatusFilterChanged(object value)
    {
        try
        {
            await LocalStorage.SetAsync("dashboardStatusFilter", selectedStatuses);
        }
        catch { /* Ignore */ }
        
        await LoadTasks();
    }

    private async void RefreshData()
    {
        await InvokeAsync(async () =>
        {
            var project = ProjectContext.SelectedProject;
            if (hubConnection?.State == HubConnectionState.Connected && project != null)
            {
                await hubConnection.InvokeAsync("JoinProject", project.Id.ToString());
            }
            await LoadTasks();
            StateHasChanged();
        });
    }

    private async Task LoadTasks()
    {
        if (ProjectContext.SelectedProject != null)
        {
            var response = await TaskService.GetTasksAsync(ProjectContext.SelectedProject.Id, selectedStatuses, null, null, currentUserId, 1, 100);
            tasks = response.Items;
        }
    }

    private Task OnTaskEventReceivedAsync() =>
        InvokeAsync(async () =>
        {
            await LoadTasks();
            expandedTaskIds.IntersectWith(tasks.Select(t => t.Id));
            if (grid is not null && expandedTaskIds.Count > 0)
            {
                await grid.ExpandRows(tasks.Where(t => expandedTaskIds.Contains(t.Id)));
            }
            StateHasChanged();
        });

    private void OnRowExpand(TaskItemSummaryDto task) => expandedTaskIds.Add(task.Id);

    private void OnRowCollapse(TaskItemSummaryDto task) => expandedTaskIds.Remove(task.Id);

    private async Task OnRowSelect(TaskItemSummaryDto t)
    {
        var title = $"Task Details: {t.Id.ToString()[..8]}";
        if (!string.IsNullOrEmpty(t.TaskHandle))
        {
            title += $" ({t.TaskHandle})";
        }

        var result = await DialogService.OpenAsync<TaskDetailDialog>(title,
            new Dictionary<string, object> { { "TaskId", t.Id } },
            new DialogOptions { Width = "80vw", Height = "80vh" });

        if (result == true)
        {
            await LoadTasks();
        }
    }

    private async Task OnNewTask()
    {
        var newTask = new CreateTaskRequest { Title = "New Task" };
        var result = await DialogService.OpenAsync("Create New Task", ds =>
            @<RadzenStack Gap="1rem">
                <RadzenFormField Text="Title">
                    <RadzenTextBox @bind-Value="newTask.Title" />
                </RadzenFormField>
                <RadzenFormField Text="Handle (Required)">
                    <RadzenTextBox @bind-Value="newTask.TaskHandle" Placeholder="e.g. login-page" />
                </RadzenFormField>
                <RadzenFormField Text="Priority">
                    <RadzenDropDown TValue="TaskPriority" Data="@(Enum.GetValues<TaskPriority>())" @bind-Value="newTask.Priority" />
                </RadzenFormField>
                @if (ProjectContext.SelectedProject?.TaskTypes?.Any() == true)
                {
                    <RadzenFormField Text="Task Type">
                        <RadzenDropDown TValue="string" Data="@ProjectContext.SelectedProject.TaskTypes" @bind-Value="newTask.TaskType" />
                    </RadzenFormField>
                }
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenButton Text="Cancel" Click="@(() => ds.Close(false))" ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text="Create" Click="@(() => { if(!string.IsNullOrWhiteSpace(newTask.TaskHandle)) ds.Close(true); })" ButtonStyle="ButtonStyle.Primary" Disabled="@string.IsNullOrWhiteSpace(newTask.TaskHandle)" />
                </RadzenStack>
            </RadzenStack>
        );

        var selectedProject = ProjectContext.SelectedProject;
        if (result == true && selectedProject is not null)
        {
            await TaskService.CreateTaskAsync(selectedProject!.Id, newTask, currentUserId);
            await LoadTasks();
        }
    }

    private async Task OnStatusChange(TaskItemSummaryDto task, TaskItemStatus newStatus)
    {
        editingStatusId = null;
        if (task.Status == newStatus) return;

        try
        {
            await TaskService.UpdateTaskStatusAsync(task.Id, newStatus, currentUserId);
            // No need to manually reload, SignalR will trigger RefreshData -> LoadTasks
        }
        catch (Exception ex)
        {
            // Revert UI if update fails (though grid reload will fix it eventually)
            await LoadTasks(); 
            // Ideally show notification
        }
    }

    private BadgeStyle GetStatusStyle(TaskItemStatus status) => status switch
    {
        TaskItemStatus.Open => BadgeStyle.Info,
        TaskItemStatus.InProgress => BadgeStyle.Warning,
        TaskItemStatus.Completed => BadgeStyle.Success,
        TaskItemStatus.Blocked => BadgeStyle.Danger,
        TaskItemStatus.Cancelled => BadgeStyle.Light,
        _ => BadgeStyle.Secondary
    };

    private BadgeStyle GetPriorityStyle(TaskPriority priority) => priority switch
    {
        TaskPriority.Critical => BadgeStyle.Danger,
        TaskPriority.High => BadgeStyle.Warning,
        TaskPriority.Medium => BadgeStyle.Info,
        TaskPriority.Low => BadgeStyle.Success,
        _ => BadgeStyle.Secondary
    };

    public async ValueTask DisposeAsync()
    {
        ProjectContext.OnProjectChanged -= RefreshData;
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
