<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-reconnect-badge">
            <img src="logo1.png" alt="WATR" class="components-reconnect-logo" />
            <span class="components-reconnect-brand">WATR</span>
        </div>

        <div class="components-rejoining-animation" aria-hidden="true">
            <div class="spinner-ring outer-ring"></div>
            <div class="spinner-ring inner-ring"></div>
        </div>

        <div class="components-reconnect-content">
            <p class="components-reconnect-first-attempt-visible">
                Reconnecting to server...
            </p>
            <p class="components-reconnect-repeated-attempt-visible">
                Rejoin failed. Retrying in <span id="components-seconds-to-next-attempt"></span>s...
            </p>
            <p class="components-reconnect-failed-visible">
                Connection lost.<br />
                <span class="components-reconnect-subtext">Unable to restore session with server.</span>
            </p>
            <p class="components-pause-visible">
                Session paused by the server.
            </p>
            <p class="components-resume-failed-visible">
                Failed to resume session.<br />
                <span class="components-reconnect-subtext">Please reload the page.</span>
            </p>
        </div>

        <div class="components-reconnect-actions">
            <button id="components-reconnect-button" class="components-reconnect-failed-visible btn-reconnect">
                Retry Connection
            </button>
            <button id="components-reload-button" class="components-reconnect-failed-visible btn-reload" onclick="location.reload()">
                Reload Page
            </button>
            <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible btn-reconnect">
                Resume Session
            </button>
        </div>
    </div>
</dialog>

