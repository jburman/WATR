@page "/login"
@using HotShallot.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@using HotShallot.Web.Components.Layout
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Login - HotShallot</PageTitle>

<style>
    /* Font Loading */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    @@import url('https://fonts.googleapis.com/icon?family=Material+Icons');

    body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #121212;
    }

    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        width: 100vw;
        background: radial-gradient(circle at top right, #3a2212 0%, #121212 60%),
                    radial-gradient(circle at bottom left, #1a1a1a 0%, #000000 100%);
        position: relative;
        overflow: hidden;
    }
    
    .bg-shape {
        position: absolute;
        filter: blur(80px);
        opacity: 0.4;
        z-index: 0;
    }
    .shape-1 { top: -10%; right: -10%; width: 500px; height: 500px; background: #e67e22; border-radius: 50%; }
    .shape-2 { bottom: -10%; left: -5%; width: 400px; height: 400px; background: #8e44ad; border-radius: 50%; }

    .login-card {
        width: 100%;
        max-width: 400px;
        padding: 2.5rem;
        border-radius: 24px;
        background: rgba(30, 30, 30, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .logo-header {
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .app-subtitle {
        color: #888;
        font-size: 0.9rem;
        margin-top: 0.25rem;
    }

    /* Custom Toggle Switch */
    .toggle-container {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 12px;
        padding: 4px;
        display: flex;
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.05);
        z-index: 20;
    }

    .toggle-btn {
        flex: 1;
        background: transparent;
        border: none;
        color: #888;
        padding: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        border-radius: 10px;
        transition: all 0.3s ease;
        position: relative;
        z-index: 21;
        font-family: 'Inter', sans-serif;
    }

    .toggle-btn:hover {
        color: #ccc;
    }

    .toggle-btn.active {
        color: white;
        background: rgba(255, 255, 255, 0.1);
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    /* Inputs */
    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-label {
        font-size: 0.85rem;
        color: #bbb;
        font-weight: 500;
        margin-left: 4px;
    }

    .custom-input {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        padding: 14px 16px;
        border-radius: 12px !important;
        width: 100%;
        box-sizing: border-box;
        font-size: 1rem;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: all 0.2s;
    }

    .custom-input:focus {
        border-color: #e67e22;
        box-shadow: 0 0 0 4px rgba(230, 126, 34, 0.15);
        background: rgba(0, 0, 0, 0.5);
    }

    .custom-input::placeholder {
        color: #555;
    }

    /* Main Action Button */
    .action-btn {
        background: linear-gradient(135deg, #f39c12 0%, #d35400 100%);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 4px 15px rgba(211, 84, 0, 0.3);
        font-family: 'Inter', sans-serif;
        margin-top: 0.5rem;
        z-index: 20;
    }

    .action-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(211, 84, 0, 0.4);
    }

    .action-btn:active {
        transform: translateY(0);
    }

    .action-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }

    .secondary-btn {
        background: rgba(255, 255, 255, 0.1);
        background: linear-gradient(135deg, #333 0%, #444 100%);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }
    .secondary-btn:hover {
        background: linear-gradient(135deg, #444 0%, #555 100%);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }

    /* Icon styling */
    .material-icons {
        font-family: 'Material Icons';
        font-weight: normal;
        font-style: normal;
        font-size: 24px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
    }

    .footer {
        text-align: center;
        color: #666;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }
</style>

<div class="login-container">
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>

    <div class="login-card">
        <div class="logo-header">
            <div class="cyberpunk-logo" style="display: inline-flex; align-items: center; gap: 15px; margin-bottom: 1rem; margin-top: 20px; cursor: default; position: relative; z-index: 20;">
                <img src="logo1.png" alt="Logo" style="height: 128px; margin-top: -50px; margin-bottom: -50px; margin-left: -20px;" />
                <span style="font-size: 1.5rem;">HotShallot</span>
            </div>
            <div class="app-subtitle">Cooking up code</div>
        </div>

        <div class="toggle-container">
            <button type="button" class="toggle-btn @(isLogin ? "active" : "")" @onclick="SwitchToLogin">Login</button>
            <button type="button" class="toggle-btn @(!isLogin ? "active" : "")" @onclick="SwitchToSignUp">Sign Up</button>
        </div>

        @if (isLogin)
        {
            <div class="input-group">
                <label class="input-label">Email Address</label>
                <input @bind="loginEmail" @bind:event="oninput" class="custom-input" placeholder="agent@example.com" />
            </div>

            <button type="button" class="action-btn" @onclick="OnLogin" disabled="@isBusy">
                @if (isBusy)
                {
                    <span class="material-icons spin">refresh</span> <span>Processing...</span>
                }
                else
                {
                    <span class="material-icons">fingerprint</span> <span>Continue with Passkey</span>
                }
            </button>
        }
        else
        {
            <div class="input-group">
                <label class="input-label">Email Address</label>
                <input @bind="regEmail" @bind:event="oninput" class="custom-input" placeholder="agent@example.com" />
            </div>
            <div class="input-group">
                <label class="input-label">Display Name</label>
                <input @bind="displayName" @bind:event="oninput" class="custom-input" placeholder="Coding Agent 007" />
            </div>

            <button type="button" class="action-btn secondary-btn" @onclick="OnRegister" disabled="@isBusy">
                 @if (isBusy)
                {
                    <span class="material-icons spin">refresh</span> <span>Creating Account...</span>
                }
                else
                {
                    <span class="material-icons">person_add</span> <span>Create Account</span>
                }
            </button>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="background: rgba(231, 76, 60, 0.2); border: 1px solid #c0392b; color: #ffad99; padding: 12px; border-radius: 8px; font-size: 0.9rem; text-align: center;">
                <span class="material-icons" style="font-size: 16px; vertical-align: text-bottom;">error_outline</span> @error
            </div>
        }

        <div class="footer">
            <span class="material-icons" style="font-size: 14px;">lock</span> Secure Passwordless Auth
        </div>
    </div>
</div>

<style>
    .spin {
        animation: spin 1s linear infinite;
    }
    @@keyframes spin { 100% { -webkit-transform: rotate(360deg); transform:rotate(360deg); } }
</style>

@code {
    private bool isLogin = true;
    private string loginEmail = "";
    private string regEmail = "";
    private string displayName = "";
    private string error = "";
    private bool isBusy = false;

    private void SwitchToLogin()
    {
        isLogin = true;
        error = "";
    }

    private void SwitchToSignUp()
    {
        isLogin = false;
        error = "";
    }

    async Task OnLogin()
    {
        if (string.IsNullOrWhiteSpace(loginEmail))
        {
            error = "Please enter your email.";
            return;
        }

        error = "";
        isBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var optionsResponse = await Http.PostAsJsonAsync("api/auth/passkey/login-options", new LoginOptionsRequest { Email = loginEmail });
            if (!optionsResponse.IsSuccessStatusCode)
            {
                error = await optionsResponse.Content.ReadAsStringAsync();
                try {
                     var errObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(error);
                     if (errObj != null && !string.IsNullOrEmpty(errObj.Message)) error = errObj.Message;
                } catch {}
                return;
            }

            var optionsJson = await optionsResponse.Content.ReadAsStringAsync();
            
            string assertionJson;
            try
            {
                assertionJson = await JSRuntime.InvokeAsync<string>("loginPassKey", optionsJson);
            }
            catch (Exception)
            {
                error = "Passkey interaction cancelled or timed out.";
                return;
            }

            // Perform login via JS fetch so the cookie is set on the browser
            try
            {
                await JSRuntime.InvokeVoidAsync("performLogin", $"api/auth/passkey/login?email={Uri.EscapeDataString(loginEmail)}", assertionJson);
                Navigation.NavigateTo("/", true);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Login error: {ex.Message}");
                error = "Login failed. Ensure you have registered a passkey for this email.";
            }
        }
        catch (Exception ex)
        {
            error = "An unexpected error occurred.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    async Task OnRegister()
    {
        if (string.IsNullOrWhiteSpace(regEmail) || string.IsNullOrWhiteSpace(displayName))
        {
            error = "Email and Display Name are required.";
            return;
        }

        error = "";
        isBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var optionsResponse = await Http.PostAsJsonAsync("api/auth/passkey/register-options", 
                new RegisterOptionsRequest { Email = regEmail, DisplayName = displayName });
            
            if (!optionsResponse.IsSuccessStatusCode)
            {
                error = await optionsResponse.Content.ReadAsStringAsync();
                try {
                     var errObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(error);
                     if (errObj != null && !string.IsNullOrEmpty(errObj.Message)) error = errObj.Message;
                } catch {}
                return;
            }

            var optionsJson = await optionsResponse.Content.ReadAsStringAsync();
            
            string attestationJson;
            try 
            {
                attestationJson = await JSRuntime.InvokeAsync<string>("registerPassKey", optionsJson);
            }
            catch (Exception)
            {
                error = "Passkey registration cancelled.";
                return;
            }

            var regResponse = await Http.PostAsJsonAsync($"api/auth/passkey/register?email={regEmail}&displayName={displayName}", 
                System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(attestationJson));

            if (regResponse.IsSuccessStatusCode)
            {
                error = "";
                await JSRuntime.InvokeVoidAsync("alert", "Registration Successful! Switching to Login...");
                loginEmail = regEmail;
                isLogin = true;
            }
            else
            {
                error = await regResponse.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            error = "Registration failed.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
