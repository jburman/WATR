@inherits LayoutComponentBase
@using HotShallot.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ProjectService ProjectService
@inject ProjectContextService ProjectContext
@inject NavigationManager Navigation
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenComponents />

<RadzenLayout Style="grid-template-areas: 'rz-header' 'rz-body'; grid-template-columns: 1fr; grid-template-rows: auto 1fr;">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" class="rz-p-2 w-100">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <a href="/" class="cyberpunk-logo" style="display: flex; align-items: center; gap: 10px; position: relative; z-index: 10;">
                    <img src="logo1.png" alt="Logo" style="height: 80px; margin-top: -23px; margin-bottom: -27px; margin-left: -12px;" />
                    <span>HotShallot</span>
                </a>
                
                <AuthorizeView>
                    <Authorized>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenDropDown TValue="Guid?" 
                                            Data="@projects" 
                                            TextProperty="Name" 
                                            ValueProperty="Id" 
                                            Value="@ProjectContext.SelectedProject?.Id"
                                            Change="@OnProjectChanged"
                                            Placeholder="Select Project..."
                                            Style="width: 250px;" />
                            <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="@OnCreateProject" Tooltip="Create New Project" />
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Click="@OnEditProject" Disabled="@(ProjectContext.SelectedProject == null)" Tooltip="Edit Project" />
                        </RadzenStack>
                    </Authorized>
                </AuthorizeView>
            </RadzenStack>
            
            <AuthorizeView>
                <Authorized>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenLink Path="/admin/users" Text="Admin" Icon="admin_panel_settings" Style="margin-right: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Body2">@context.User.Identity?.Name</RadzenText>
                        <RadzenButton Icon="logout" Size="ButtonSize.Small" Variant="Variant.Text" Click="@Logout" />
                    </RadzenStack>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private List<ProjectDto> projects = new();

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        var authState = await authenticationStateTask;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var userId = Guid.Parse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
            projects = await ProjectService.GetUserProjectsAsync(userId);
            
            if (ProjectContext.SelectedProject == null && projects.Any())
            {
                var storedId = await ProjectContext.GetStoredProjectIdAsync();
                var projectToSelect = projects.FirstOrDefault(p => p.Id == storedId) ?? projects.First();
                await ProjectContext.SelectProjectAsync(projectToSelect);
            }
        }
    }

    private async Task OnProjectChanged(object value)
    {
        if (value is Guid projectId)
        {
            var project = projects.FirstOrDefault(p => p.Id == projectId);
            await ProjectContext.SelectProjectAsync(project);
        }
    }

    private async Task OnCreateProject()
    {
        var request = new CreateProjectRequest();
        string taskTypesString = "Epic\nTask";

        var result = await DialogService.OpenAsync("Create New Project", ds =>
            @<RadzenStack Gap="1rem">
                <RadzenFormField Text="Project Name">
                    <RadzenTextBox @bind-Value="request.Name" style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Description">
                    <RadzenTextArea @bind-Value="request.Description" style="width: 100%;" Rows="3" />
                </RadzenFormField>
                <RadzenFormField Text="Task Types (one per line)">
                    <RadzenTextArea @bind-Value="taskTypesString" style="width: 100%;" Rows="3" />
                </RadzenFormField>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenButton Text="Cancel" Click="@(() => ds.Close(false))" ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text="Create" Click="@(() => ds.Close(true))" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenStack>
        );

        if (result == true)
        {
            if (string.IsNullOrWhiteSpace(request.Name))
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Project name is required.");
                return;
            }

            request.TaskTypes = taskTypesString
                .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            var authState = await authenticationStateTask;
            var userId = Guid.Parse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);

            try 
            {
                var newProject = await ProjectService.CreateProjectAsync(request, userId);
                await LoadProjects();
                await ProjectContext.SelectProjectAsync(newProject); // Auto-select the new project
                NotificationService.Notify(NotificationSeverity.Success, "Success", $"Project '{newProject.Name}' created.");
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to create project: {ex.Message}");
            }
        }
    }

    private async Task OnEditProject()
    {
        if (ProjectContext.SelectedProject == null) return;

        var project = ProjectContext.SelectedProject;
        var request = new UpdateProjectRequest
        {
            Name = project.Name,
            Description = project.Description,
            TaskTypes = project.TaskTypes.ToList()
        };
        
        string taskTypesString = string.Join("\n", request.TaskTypes);

        var result = await DialogService.OpenAsync("Edit Project", ds =>
            @<RadzenStack Gap="1rem">
                <RadzenFormField Text="Project Name">
                    <RadzenTextBox @bind-Value="request.Name" style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Description">
                    <RadzenTextArea @bind-Value="request.Description" style="width: 100%;" Rows="3" />
                </RadzenFormField>
                <RadzenFormField Text="Task Types (one per line)">
                    <RadzenTextArea @bind-Value="taskTypesString" style="width: 100%;" Rows="5" />
                </RadzenFormField>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenButton Text="Cancel" Click="@(() => ds.Close(false))" ButtonStyle="ButtonStyle.Light" />
                    <RadzenButton Text="Save" Click="@(() => ds.Close(true))" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenStack>
        );

        if (result == true)
        {
            if (string.IsNullOrWhiteSpace(request.Name))
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Project name is required.");
                return;
            }

            request.TaskTypes = taskTypesString.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            var authState = await authenticationStateTask;
            var userId = Guid.Parse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);

            try 
            {
                var updatedProject = await ProjectService.UpdateProjectAsync(project.Id, request, userId);
                await LoadProjects();
                await ProjectContext.SelectProjectAsync(updatedProject);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Project updated.");
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to update project: {ex.Message}");
            }
        }
    }

    private async Task Logout()
    {
        await Http.PostAsync("api/auth/logout", null);
        Navigation.NavigateTo("/login", true);
    }
}
